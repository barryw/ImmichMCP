<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ImmichMCP</RootNamespace>
    <AssemblyName>ImmichMCP</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- NuGet Package -->
    <IsPackable>true</IsPackable>
    <PackageId>ImmichMCP</PackageId>
    <Authors>Barry Walker</Authors>
    <Description>Model Context Protocol server for Immich photo management</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/barryw/ImmichMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/barryw/ImmichMCP</RepositoryUrl>
    <PackageTags>mcp;immich;photos;claude;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>3.0.0</Version>
    <PackageReleaseNotes>Updates Immich API support for Immich v3.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.9" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImmichMCP.Tests" />
  </ItemGroup>

</Project>
